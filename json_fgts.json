      "/v1/trabalhadores/protocolos/consultas-protocolo/{cpf}/{protocolo}":{
         "get":{
            "tags":[
               "Consultas Desenrola 2.0"
            ],
            "summary":"Consulta as informações do protocolo solicitado.",
            "description":"A consulta retorna o status do protocolo da solicitação de inclusão da informação de dívida, exclusao da informação de dívida ou da consulta do saldo líquido simulado.",
            "parameters":[
               {
                  "name":"cpf",
                  "in":"path",
                  "description":"CPF do Trabalhador (sem formatação).",
                  "required":true,
                  "schema":{
                     "type":"string",
                     "minLength":11,
                     "maxLength":11
                  }
               },
               {
                  "name":"protocolo",
                  "in":"path",
                  "description":"Protocolo da solicitação.",
                  "required":true,
                  "schema":{
                     "type":"integer",
                     "format":"int64",
                     "minimum":1
                  }
               },
               {
                  "name":"apikey",
                  "in":"header",
                  "description":"Secret da aplicação fornecido pela Caixa Econômica Federal para consumo da API.",
                  "required":true,
                  "schema":{
                     "type":"string"
                  }
               }
            ],
            "responses":{
               "200":{
                  "description":"Consulta realizada com sucesso.",
                  "content":{
                     "application/json":{
                        "examples":{
                           "inclusao":{
                              "summary":"Inclusão da informação de dívida",
                              "value":{
                                 "protocoloSolicitacao":1001,
                                 "tipoProtocolo":1,
                                 "dataHoraSolicitacao":"01/05/2026 10:00:00",
                                 "statusProtocolo":3,
                                 "vrOriginal":1000,
                                 "vrRenegociado":800,
                                 "vrFgts":500
                              }
                           },
                           "exclusao":{
                              "summary":"Exclusão da informação de dívida",
                              "value":{
                                 "protocoloSolicitacao":1002,
                                 "tipoProtocolo":2,
                                 "dataHoraSolicitacao":"02/05/2026 14:30:00",
                                 "statusProtocolo":3,
                                 "protocolo":456
                              }
                           },
                           "saldoLiquido":{
                              "summary":"Consulta de saldo líquido simulado",
                              "value":{
                                 "protocoloSolicitacao":1004,
                                 "tipoProtocolo":3,
                                 "dataHoraSolicitacao":"04/05/2026 16:45:20",
                                 "statusProtocolo":3,
                                 "dataHoraConsulta":"04/05/2026 16:47:05",
                                 "vrMaximoDebito":2150.75
                              }
                           }
                        },
                        "schema":{
                           "$ref":"#/components/schemas/ConsultaProtocolo"
                        }
                     }
                  }
               },
               "400":{
                  "description":"3.CPF inválido. 7.Não é possível realizar a operação para o CPF informado. 10.Protocolo inválido.",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/Mensagem"
                        }
                     }
                  }
               },
               "401":{
                  "description":"1.Usuário não autenticado.",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/Mensagem"
                        }
                     }
                  }
               },
               "403":{
                  "description":"8.Instituição Financeira não possui autorização do Trabalhador para o Programa Desenrola 2.0.",
                  "content":{
