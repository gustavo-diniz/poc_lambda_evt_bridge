                  ],
                  "APIKey":[
                     
                  ]
               }
            ]
         }
      }
   },
   "components":{
      "schemas":{
         "InformacaoDivida":{
            "required":[
               "vrOriginal",
               "vrRenegociado",
               "vrFgts"
            ],
            "type":"object",
            "properties":{
               "vrOriginal":{
                  "type":"number",
                  "format":"decimal",
                  "minimum":0.01,
                  "multipleOf":0.01,
                  "description":"Valor Bruto devido pelo trabalhador para a Instituição Financeira no momento inicial antes da renegociação."
               },
               "vrRenegociado":{
                  "type":"number",
                  "format":"decimal",
                  "minimum":0.01,
                  "multipleOf":0.01,
                  "description":"Valor devido pelo trabalhador após a renegociação efetuada no âmbito do Programa Desenrola 2.0."
               },
               "vrFgts":{
                  "type":"number",
                  "format":"decimal",
                  "minimum":0.01,
                  "multipleOf":0.01,
                  "description":"Valor a ser debitado da conta de FGTS, para utilização no âmbito do Programa Desenrola 2.0."
               }
            }
         },
         "Protocolo":{
            "required":[
               "protocolo"
            ],
            "type":"object",
            "properties":{
               "protocolo":{
                  "type":"integer",
                  "format":"int64",
                  "minimum":1,
                  "description":"Identificador numérico de um protocolo gerado pela Caixa Econômica Federal em respostas de inclusão ou exclusão da informação de dívida ou de consulta do saldo líquido simulado, representa o protocolo associado à solicitação."
               }
            }
         },
         "ProtocoloBase":{
            "required":[
               "protocoloSolicitacao",
               "tipoProtocolo",
               "dataHoraSolicitacao",
               "statusProtocolo"
            ],
            "type":"object",
            "properties":{
               "protocoloSolicitacao":{
                  "type":"integer",
                  "format":"int64",
                  "minimum":1,
                  "description":"Protocolo da solicitação."
               },
               "tipoProtocolo":{
                  "type":"integer",
                  "enum":[
                     1,
                     2,
                     3
                  ],
                  "description":"Indica o Serviço correspondente ao Número do Protocolo informado. Opções: 1 - Inclusão da informação de dívida. 2 - Exclusão da informação de dívida. 3 - Consulta Saldo Líquido Simulado."
               },
               "dataHoraSolicitacao":{
                  "type":"string",
                  "description":"Data Hora de referência da Solicitação de Inclusão ou Exclusão da informação da dívida ou Consulta do Saldo Líquido Simulado no formato ."
               },
               "statusProtocolo":{
                  "type":"integer",
                  "enum":[
                     1,
                     2,
                     3,
                     4
                  ],
                  "description":"Status do Processamento da Transação. Pode ser: 1 – Recepcionada. Sua solicitação foi recepcionada. 2 – Em processamento. Sua solicitação encontra-se em processamento. 3 – Processada. Sua solicitação foi executada com sucesso. 4 – Rejeitada. Sua solicitação foi rejeitada."
               },
               "motivoStatus":{
                  "type":"string",
                  "description":"Motivo do Status do Protocolo caso o Status do Protocolo seja 4 - Rejeitada."
               }
            }
         },
         "ConsultaProtocolo":{
            "oneOf":[
               {
                  "$ref":"#/components/schemas/InformacoesDividaInclusao"
               },
               {
                  "$ref":"#/components/schemas/InformacoesDividaExclusao"
               },
               {
                  "$ref":"#/components/schemas/SaldoLiquidoSimulado"
               }
            ],
            "discriminator":{
               "propertyName":"tipoProtocolo",
               "mapping":{
                  "1":"#/components/schemas/InformacoesDividaInclusao",
                  "2":"#/components/schemas/InformacoesDividaExclusao",
                  "3":"#/components/schemas/SaldoLiquidoSimulado"
               }
            }
         },
         "InformacoesDividaInclusao":{
            "allOf":[
               {
                  "$ref":"#/components/schemas/ProtocoloBase"
               },
               {
                  "$ref":"#/components/schemas/InformacaoDivida"
               }
            ]
         },
         "InformacoesDividaExclusao":{
            "allOf":[
               {
                  "$ref":"#/components/schemas/ProtocoloBase"
               },
               {
                  "$ref":"#/components/schemas/Protocolo"
               }
            ]
         },
         "SaldoLiquidoSimulado":{
            "allOf":[
               {
                  "$ref":"#/components/schemas/ProtocoloBase"
               },
               {
                  "$ref":"#/components/schemas/SaldoLiquido"
               }
            ]
         },
         "SaldoLiquido":{
            "type":"object",
            "description":"Os campos dataHoraConsulta e vrMaximoDebito somente serão retornados quando o statusProtocolo for igual a 3 (Processada).\n",
            "properties":{
               "dataHoraConsulta":{
                  "type":"string",
                  "description":"Data Hora de referência do processamento da solicitação da Consulta do Saldo Líquido Simulado no formato . Preenchido apenas quando statusProtocolo = 3 (Processada)."
               },
               "vrMaximoDebito":{
                  "type":"number",
                  "format":"decimal",
                  "minimum":0,
                  "multipleOf":0.01,
                  "description":"Valor máximo para débito. Preenchido apenas quando statusProtocolo = 3 (Processada)."
               }
            }
         },
         "Mensagem":{
            "required":[
               "codigo",
               "descricao"
            ],
            "type":"object",
            "properties":{
               "codigo":{
                  "type":"integer",
                  "format":"int32",
                  "description":"Código do erro."
               },
               "descricao":{
                  "type":"string",
                  "description":"Descrição do erro."
               }
            }
         }
      },
      "securitySchemes":{
         "APIKey":{
            "description":"API Key do sistema que está chamando esta API.",
            "in":"header",
            "name":"APIKey",
            "type":"apiKey"
         },
         "Internet":{
            "description":"Tokens emitidos pelo realm INTERNET",
            "flows":{
               "clientCredentials":{
                  "refreshUrl":"https://logindes.caixa.gov.br/auth/realms/internet/protocol/openid-connect/token",
                  "scopes":{
                     "mp-desenrola-2.0-if":"Permite atender as Instituições Financeiras referente ao Programa Desenrola 2.0."
                  },
                  "tokenUrl":"https://logindes.caixa.gov.br/auth/realms/internet/protocol/openid-connect/token"
               }
            },
            "type":"oauth2"
         }
      }
   }
}