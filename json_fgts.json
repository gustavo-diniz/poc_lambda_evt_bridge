{
   "openapi":"3.0.1",
   "info":{
      "title":"FGTS - MP Desenrola 2.0 - Instituições Financeiras",
      "description":"Essa API tem como finalidade atender às Instituições Financeiras em conformidade com a MP nº 1.355/2026 do Programa Desenrola 2.0. \n\n# Authentication\n\n",
      "termsOfService":"https://api.caixa/terms",
      "contact":{
         "email":"cesoa020@caixa.gov.br"
      },
      "version":"1.0.0"
   },
   "servers":[
      {
         "url":"https://api.des.caixa:8443/fgts/mp-desenrola-20-if"
      }
   ],
   "paths":{
      "/v1/trabalhadores/solicitacoes-inclusao-divida/{cpf}":{
         "post":{
            "tags":[
               "Solicitações Desenrola 2.0"
            ],
            "summary":"Solicitar uma inclusão da informação de dívida.",
            "description":"Permite a Instituição Financeira solicitar uma inclusão da informação de dívida.",
            "parameters":[
               {
                  "name":"cpf",
                  "in":"path",
                  "description":"CPF do Trabalhador (sem formatação).",
                  "required":true,
                  "schema":{
                     "type":"string",
                     "minLength":11,
                     "maxLength":11
                  }
               },
               {
                  "name":"apikey",
                  "in":"header",
                  "description":"Secret da aplicação fornecido pela Caixa Econômica Federal para consumo da API.",
                  "required":true,
                  "schema":{
                     "type":"string"
                  }
               }
            ],
            "requestBody":{
               "description":"Body da solicitação de inclusão da informação de dívida.",
               "content":{
                  "application/json":{
                     "schema":{
                        "$ref":"#/components/schemas/InformacaoDivida"
                     }
                  }
               },
               "required":true
            },
            "responses":{
               "202":{
                  "description":"Sua solicitação foi recebida com sucesso para processamento na Caixa Econômica Federal. Retorna o protocolo da solicitação de inclusão da informação de dívida. Verificar status do protocolo para confirmar o resultado da operação.",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/Protocolo"
                        }
                     }
                  }
               },
               "400":{
                  "description":"3.CPF inválido. 4.Valor Original inválido. 5.Valor Renegociado inválido. 6.Valor de FGTS inválido. 7.Não é possível realizar a operação para o CPF informado.",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/Mensagem"
                        }
                     }
                  }
               },
               "401":{
                  "description":"1.Usuário não autenticado.",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/Mensagem"
                        }
                     }
                  }
               },
               "403":{
                  "description":"8.Instituição Financeira não possui autorização do Trabalhador para o Programa Desenrola 2.0.",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/Mensagem"
                        }
                     }
                  }
               },
               "404":{
                  "description":"9.Trabalhador não localizado na base do FGTS.",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/Mensagem"
                        }
                     }
                  }
               },
               "409":{
                  "description":"12.Existe uma Operação do Programa Desenrola 2.0 em andamento. Tente novamente mais tarde.",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/Mensagem"
                        }
                     }
                  }
               },
               "500":{
                  "description":"2.Ocorreu um erro inesperado. Tente novamente mais tarde.",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/Mensagem"
                        }
                     }
                  }
               }
            },
            "security":[
               {
                  "Internet":[
                     "mp_desenrola_2.0_if"
                  ],
                  "APIKey":[
                     
                  ]
               }
            ]
         }
      },
