                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/Mensagem"
                        }
                     }
                  }
               }
            },
            "security":[
               {
                  "Internet":[
                     "mp_desenrola_2.0_if"
                  ],
                  "APIKey":[
                     
                  ]
               }
            ]
         }
      },
