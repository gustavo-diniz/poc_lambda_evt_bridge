{
  "name": "gerador-bbsia-manual",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gerador manual do arquivo de Remessa GFG0010 (FGO / BB SIA) a partir de um CSV, sem base de dados.",
  "scripts": {
    "gerar": "tsx src/index.ts",
    "gerar:exemplo": "tsx src/index.ts --csv entrada/exemplo-remessa.csv --config config/parametros.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
